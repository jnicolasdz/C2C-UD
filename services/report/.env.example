PROJECT_NAME=UD Marketplace Reports API
API_V1_PREFIX=/api/v1

# Docker local database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/marketplace_reports

# Local email testing with Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reportes@udmarketplace.local
MAIL_ENABLED=true
MAIL_USE_TLS=false

# Frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:4200,http://localhost:5173,http://localhost:3000,http://localhost:8080
